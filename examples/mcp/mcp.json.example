{
  "mcpServers": {
    "1msg-example": {
      "command": "node",
      "args": ["src/index.js"],
      "cwd": "/absolute/path/to/1msg-sdk/examples/mcp",
      "env": {
        "CHAT_API_BASE_URL": "https://api.1msg.io",
        "CHAT_API_INSTANCE_ID": "YOUR_INSTANCE_ID",
        "CHAT_API_TOKEN": "YOUR_CHANNEL_TOKEN"
      }
    }
  }
}
