{
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.mjs!",
        "quality/generator/*.mjs!",
        "quality/exceptions/*.mjs!",
        "eslint*.mjs!",
        "quality.config.mjs!"
      ],
      "project": ["scripts/*.mjs!", "quality/generator/*.mjs!", "quality/exceptions/*.mjs!"]
    },
    "typescript": {
      "entry": ["src/index.ts!", "src/__tests__/**/*.test.ts"],
      "project": ["src/*.ts!", "src/generated/**/*.ts!", "src/__tests__/**/*.ts"]
    }
  },
  "ignoreBinaries": ["java"],
  "ignore": ["tools/quality/**", "typescript/src/generated/**"]
}
